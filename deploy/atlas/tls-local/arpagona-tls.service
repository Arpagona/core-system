[Unit]
Description=Proxy HTTPS local ARPAGONA (Atlas et pont GONA)
After=network-online.target wg-quick@wg0.service arpagona-api.service
Requires=wg-quick@wg0.service
Conflicts=arpagona-gona-relay.service

[Service]
Type=simple
RuntimeDirectory=arpagona-tls
ExecStartPre=/usr/sbin/nginx -t -c /etc/arpagona-tls/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/arpagona-tls/nginx.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -s reload -c /etc/arpagona-tls/nginx.conf
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
