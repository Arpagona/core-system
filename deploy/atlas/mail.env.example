# Configuration du courriel sortant — Agent Core
#
# Copier en /etc/arpagona-api/mail.env, propriétaire root:arpagona-api, mode 0640.
# Le mot de passe ne va jamais dans Git : il est lu dans un fichier séparé, mode 0600.
#
# Sans ARPAGONA_SMTP_HOST, l'API démarre normalement et l'envoi est désactivé :
# l'interface l'affiche, aucun bouton mort.

ARPAGONA_SMTP_HOST=smtp.exemple.fr
ARPAGONA_SMTP_PORT=587
ARPAGONA_SMTP_USER=agent@exemple.fr
ARPAGONA_SMTP_FROM=agent@exemple.fr
ARPAGONA_SMTP_PASSWORD_FILE=/etc/arpagona-api/smtp_password
ARPAGONA_SMTP_STARTTLS=1

# Plafonds de dépense (dollars US, appliqués côté API)
# ARPAGONA_MAX_MISSION_USD=0.50
# ARPAGONA_MAX_DAY_USD=5.00
