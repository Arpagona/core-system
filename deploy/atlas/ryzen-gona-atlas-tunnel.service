# Poste GONA (Ryzen) : tunnel SSH inversé vers Atlas. Atlas voit GONA sur 127.0.0.1:18710 (boucle locale d'Atlas).
# À installer dans ~/.config/systemd/user/ puis : systemctl --user enable --now gona-atlas-reverse-tunnel.service
[Unit]
Description=Tunnel SSH inversé GONA (Ryzen:8710) vers Atlas (127.0.0.1:18710)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -R 127.0.0.1:18710:127.0.0.1:8710 agentcore
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
